{
  "name": "openleaf-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "fidelity": "vitest run test/fidelity",
    "test": "vitest run",
    "test:all": "vitest run && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "publish:beta": "pnpm -r --filter \"./packages/**\" publish --access public --tag beta"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
