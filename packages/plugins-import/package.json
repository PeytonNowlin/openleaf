{
  "name": "@openleaf-editor/plugins-import",
  "version": "0.0.0",
  "description": "Opt-in file import for OpenLeaf: HTML and plain text with no dependency, plus a seam for .docx and other formats.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsc -p tsconfig.json" },
  "dependencies": {
    "@openleaf-editor/core": "workspace:*",
    "@openleaf-editor/paste": "workspace:*",
    "@openleaf-editor/ui": "workspace:*",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0"
  },
  "devDependencies": {
    "mammoth": "^1.8.0"
  }
}
