{
  "name": "@openleaf-editor/plugins-table",
  "version": "0.1.0-beta.0",
  "description": "Opt-in table editing for OpenLeaf: cell selection, column resizing, row and column commands, and toolbar controls. The table schema itself lives in @openleaf-editor/core so every deployment reads tables faithfully.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeytonNowlin/openleaf.git",
    "directory": "packages/plugins-table"
  },
  "homepage": "https://peytonnowlin.github.io/openleaf/",
  "bugs": {
    "url": "https://github.com/PeytonNowlin/openleaf/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@openleaf-editor/core": "workspace:*",
    "@openleaf-editor/ui": "workspace:*",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.6.4",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.37.0"
  }
}
