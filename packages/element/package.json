{
  "name": "@openleaf/element",
  "version": "0.0.0",
  "description": "The <openleaf-editor> custom element: Openleaf's drop-in for CMS forms. HTML in, HTML out, syncs to a textarea.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
