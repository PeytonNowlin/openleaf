{
  "name": "@openleaf-editor/plugins-session",
  "version": "0.1.0-beta.3",
  "description": "Opt-in finding, counting, and recovery for OpenLeaf: find and replace, word count, autosave and restore, unsaved-change warnings, save, print, preview, and new document.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeytonNowlin/openleaf.git",
    "directory": "packages/plugins-session"
  },
  "homepage": "https://peytonnowlin.github.io/openleaf/",
  "bugs": {
    "url": "https://github.com/PeytonNowlin/openleaf/issues"
  },
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openleaf-session.css": "./dist/openleaf-session.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-css.mjs"
  },
  "peerDependencies": {
    "@openleaf-editor/core": "workspace:^",
    "@openleaf-editor/ui": "workspace:^",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0"
  },
  "devDependencies": {
    "@openleaf-editor/core": "workspace:*",
    "@openleaf-editor/ui": "workspace:*",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0"
  }
}
