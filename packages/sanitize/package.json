{
  "name": "@openleaf-editor/sanitize",
  "version": "0.1.0-beta.4",
  "description": "The canonical OpenLeaf sanitization policy as data, plus configuration for DOMPurify, bleach and HTMLPurifier so client and server enforce the same rules.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeytonNowlin/openleaf.git",
    "directory": "packages/sanitize"
  },
  "homepage": "https://peytonnowlin.github.io/openleaf/",
  "bugs": {
    "url": "https://github.com/PeytonNowlin/openleaf/issues"
  },
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./allowlist.json": "./dist/allowlist.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-json.mjs"
  },
  "dependencies": {
    "@openleaf-editor/content-policy": "workspace:*"
  },
  "devDependencies": {
    "@openleaf-editor/core": "workspace:*"
  }
}
