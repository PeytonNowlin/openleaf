{
  "name": "@openleaf-editor/plugins-highlight",
  "version": "0.0.0",
  "description": "Opt-in syntax highlighting and HTML formatting for OpenLeaf: coloured code blocks and a formatted, highlighted source view. Ships a small built-in tokenizer for HTML/CSS/JS and a seam for Prism, refractor or highlight.js.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@openleaf-editor/core": "workspace:*",
    "@openleaf-editor/ui": "workspace:*",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0"
  },
  "devDependencies": {
    "refractor": "^5.0.0"
  }
}
