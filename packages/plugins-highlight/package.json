{
  "name": "@openleaf-editor/plugins-highlight",
  "version": "0.1.0-beta.3",
  "description": "Opt-in syntax highlighting and HTML formatting for OpenLeaf: coloured code blocks and a formatted, highlighted source view. Ships a small built-in tokenizer for HTML/CSS/JS and a seam for Prism, refractor or highlight.js.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeytonNowlin/openleaf.git",
    "directory": "packages/plugins-highlight"
  },
  "homepage": "https://peytonnowlin.github.io/openleaf/",
  "bugs": {
    "url": "https://github.com/PeytonNowlin/openleaf/issues"
  },
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@openleaf-editor/core": "workspace:^",
    "@openleaf-editor/ui": "workspace:^",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0"
  },
  "devDependencies": {
    "@openleaf-editor/core": "workspace:*",
    "@openleaf-editor/ui": "workspace:*",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.0",
    "refractor": "^5.0.0"
  }
}
